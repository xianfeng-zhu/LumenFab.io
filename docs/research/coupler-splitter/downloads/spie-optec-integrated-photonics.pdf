   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">IBM CMOS Integrated Silicon Nanophotonics Technology</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">IBM's new CMOS Integrated Silicon Nanophotonics chip technology integrates electrical and optical devices on the same piece of silicon, enabling computer chips to communicate using pulses of light (instead of electrical signals).</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>IBM</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>CMOS</rdf:li>
     <rdf:li>nanophotonics</rdf:li>
     <rdf:li>semiconductor</rdf:li>
     <rdf:li>chip technology</rdf:li>
     <rdf:li>electricl</rdf:li>
     <rdf:li>optical</rdf:li>
     <rdf:li>pulses of light</rdf:li>
     <rdf:li>IBM</rdf:li>
    </rdf:Bag>
   </dc:subject>
  </rdf:Description>
 </rdf:RDF>
