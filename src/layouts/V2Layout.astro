---
import BaseLayout from "./BaseLayout.astro";
import { sitePath } from "../lib/paths";
import { v2Chapters } from "../data/v2Chapters";

interface Props {
  title?: string;
  description?: string;
  chapter?: string;
  pageIndex?: number;
  frontmatter?: {
    title?: string;
    description?: string;
    chapter?: string;
    pageIndex?: number;
  };
}

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "Untitled";
const description = Astro.props.description ?? frontmatter.description;
const chapterId = Astro.props.chapter ?? frontmatter.chapter;
const pageIndex = Astro.props.pageIndex ?? frontmatter.pageIndex;

const chapterIndex = chapterId != null ? v2Chapters.findIndex((c) => c.id === chapterId) : -1;
const chapterData = chapterIndex !== -1 ? v2Chapters[chapterIndex] : null;

if (!chapterData) {
  throw new Error(
    `V2Layout: chapter "${chapterId}" not found in v2Chapters. Make sure frontmatter has 'chapter: "XX"'.`,
  );
}

const currentPage = pageIndex != null ? chapterData.pages[pageIndex] : null;
if (!currentPage) {
  throw new Error(
    `V2Layout: pageIndex ${pageIndex} out of bounds for chapter "${chapterId}" (${chapterData.pages.length} pages)`,
  );
}

// Breadcrumb: all chapters from 00 through current chapter,
// then current page title as the final (non-link) segment
const breadcrumbChain = v2Chapters.slice(0, chapterIndex + 1);

// Prev / Next
let prevUrl: string | undefined;
let prevTitle: string | undefined;
let nextUrl: string | undefined;
let nextTitle: string | undefined;

if (pageIndex > 0) {
  // Previous page in the same chapter
  const prev = chapterData.pages[pageIndex - 1];
  prevUrl = sitePath(`/v2/${chapterData.slug}/${prev.slug}/`);
  prevTitle = prev.title;
} else if (chapterIndex > 0) {
  // First page of current chapter -> last page of previous chapter
  const prevChapter = v2Chapters[chapterIndex - 1];
  const prev = prevChapter.pages[prevChapter.pages.length - 1];
  prevUrl = sitePath(`/v2/${prevChapter.slug}/${prev.slug}/`);
  prevTitle = prev.title;
}

if (pageIndex < chapterData.pages.length - 1) {
  // Next page in the same chapter
  const next = chapterData.pages[pageIndex + 1];
  nextUrl = sitePath(`/v2/${chapterData.slug}/${next.slug}/`);
  nextTitle = next.title;
} else if (chapterIndex < v2Chapters.length - 1) {
  // Last page of current chapter -> first page of next chapter
  const nextChapter = v2Chapters[chapterIndex + 1];
  const next = nextChapter.pages[0];
  nextUrl = sitePath(`/v2/${nextChapter.slug}/${next.slug}/`);
  nextTitle = next.title;
}
---

<BaseLayout title={title} description={description}>
  <div class="v2-layout">
    <div class="v2-content">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        {
          breadcrumbChain.map((ch, i) => (
            <span>
              {i > 0 && <span aria-hidden="true" class="breadcrumb__sep"> &gt; </span>}
              <a class="breadcrumb__link" href={sitePath(`/v2/${ch.slug}/${ch.pages[0].slug}/`)}>{ch.title}</a>
            </span>
          ))
        }
        <span aria-hidden="true" class="breadcrumb__sep"> &gt; </span>
        <span class="breadcrumb__current" aria-current="page">{currentPage.title}</span>
      </nav>

      <!-- Page heading -->
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}

      <!-- Main content -->
      <slot />

      <!-- Prev / Next navigation -->
      <nav class="page-nav" aria-label="Page navigation">
        <span>
          {
            prevUrl && (
              <a href={prevUrl}>
                <span aria-hidden="true">&larr;</span> {prevTitle}
              </a>
            )
          }
        </span>
        <span>
          {
            nextUrl && (
              <a href={nextUrl}>
                {nextTitle} <span aria-hidden="true">&rarr;</span>
              </a>
            )
          }
        </span>
      </nav>
    </div>

    <!-- Chapter sidebar -->
    <aside class="chapter-sidebar" aria-label="Chapter navigation">
      <div class="chapter-sidebar__inner">
        <p class="chapter-sidebar__title">{chapterData.title}</p>
        <ol class="chapter-sidebar__list">
          {
            chapterData.pages.map((page, i) => (
              <li>
                {i === pageIndex ? (
                  <strong class="chapter-sidebar__current">{page.title}</strong>
                ) : (
                  <a class="chapter-sidebar__link" href={sitePath(`/v2/${chapterData.slug}/${page.slug}/`)}>{page.title}</a>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .v2-layout {
    display: flex;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .v2-content {
    flex: 1;
    min-width: 0;
  }

  /* ---- Breadcrumb ---- */

  .breadcrumb {
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .breadcrumb__link {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .breadcrumb__link:hover {
    color: var(--accent);
  }

  .breadcrumb__sep {
    margin: 0 0.2rem;
    color: var(--muted);
  }

  .breadcrumb__current {
    color: var(--text);
  }

  /* ---- Chapter sidebar ---- */

  .chapter-sidebar {
    width: 240px;
    flex-shrink: 0;
  }

  .chapter-sidebar__inner {
    position: sticky;
    top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
  }

  .chapter-sidebar__title {
    margin: 0 0 0.75rem;
    color: var(--text);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .chapter-sidebar__list {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chapter-sidebar__list a,
  .chapter-sidebar__current {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: 0.88rem;
    line-height: 1.4;
    border-radius: 4px;
  }

  .chapter-sidebar__link {
    color: var(--text);
    text-decoration: none;
    transition: background 120ms ease;
  }

  .chapter-sidebar__link:hover {
    background: var(--surface-2);
    color: var(--accent);
  }

  .chapter-sidebar__current {
    color: var(--accent-strong);
    font-weight: 700;
    background: var(--surface-2);
  }

  /* ---- Page nav (reused global class from ConceptLayout) ---- */

  :global(.page-nav) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
  }

  :global(.page-nav) a {
    color: var(--accent);
    text-decoration: none;
    line-height: 1.6;
  }

  :global(.page-nav) a:first-child {
    margin-right: auto;
  }

  :global(.page-nav) a:last-child {
    margin-left: auto;
  }

  :global(.page-nav) a:hover {
    text-decoration: underline;
  }

  /* ---- Mobile ---- */

  @media (max-width: 720px) {
    .v2-layout {
      flex-direction: column;
    }

    .chapter-sidebar {
      width: 100%;
      margin-top: 2rem;
    }

    .chapter-sidebar__inner {
      position: static;
    }
  }
</style>
