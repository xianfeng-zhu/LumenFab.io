---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/paths";
---

<BaseLayout title=”笔记”>
  <section class=”hero-panel”>
    <p class=”page-kicker”>Notes</p>
    <h1>笔记</h1>
    <p class=”lede”>
      零散记录、待讨论话题、早期草稿和过渡性内容的存放处。主页是正式入口，
      组件页负责”看见结构”，底层页面负责”解释原因”。
    </p>
  </section>

  <section>
    <div class="section-heading">
      <p class="page-kicker">Product view</p>
      <h2>CPO / 光引擎模块</h2>
    </div>
    <div class="module-grid">
      <article class="module-card">
        <h3>Laser source / laser chip</h3>
        <ul>
          <li><a href={sitePath("/learn/why-semiconductor-lasers-are-temperature-sensitive/")}>Why semiconductor lasers are temperature-sensitive</a></li>
        </ul>
      </article>

      <article class="module-card">
        <h3>PIC</h3>
        <ul>
          <li><a href={sitePath("/learn/silicon-nitride-low-loss-passive-platform/")}>SiN as a low-loss passive platform</a></li>
          <li><a href={sitePath("/learn/tfln-and-ocs/")}>TFLN and OCS</a></li>
        </ul>
      </article>

      <article class="module-card">
        <h3>EIC / electrical side</h3>
        <ul>
          <li><a href={sitePath("/learn/inside-a-transceiver/")}>Inside a transceiver</a></li>
        </ul>
      </article>

      <article class="module-card">
        <h3>Packaging</h3>
        <ul>
          <li><a href={sitePath("/learn/soi-wafer/")}>SOI wafer</a></li>
          <li><a href={sitePath("/learn/lnoi-wafer/")}>LNOI wafer</a></li>
        </ul>
      </article>

    </div>
  </section>

  <section>
    <div class="section-heading">
      <p class="page-kicker">Foundation</p>
      <h2>底层知识域</h2>
    </div>
    <div class="topic-columns">
      <div>
        <h3>入门</h3>
        <ul>
          <li><a href={sitePath("/learn/how-to-read-this-site/")}>How to read this site</a></li>
          <li><a href={sitePath("/learn/one-page-optics-stack/")}>The one-page optics stack</a></li>
        </ul>
      </div>

      <div>
        <h3>为什么需要光互连</h3>
        <ul>
          <li><a href={sitePath("/learn/why-ai-clusters-stress-interconnects/")}>Why AI clusters stress interconnects</a></li>
          <li><a href={sitePath("/learn/copper-vs-optical-links/")}>Copper vs optical links</a></li>
          <li><a href={sitePath("/learn/bandwidth-density-and-power-per-bit/")}>Bandwidth density and power per bit</a></li>
          <li><a href={sitePath("/learn/why-800g-1-6t-and-3-2t-matter/")}>Why 800G, 1.6T, and 3.2T matter</a></li>
        </ul>
      </div>

      <div>
        <h3>光链路概览</h3>
        <ul>
          <li><a href={sitePath("/learn/dr-fr-lr-and-psm-wdm/")}>DR/FR/LR and PSM/WDM</a></li>
          <li><a href={sitePath("/learn/lane-channel-and-wavelength/")}>Lane, channel, and wavelength</a></li>
        </ul>
      </div>

      <div>
        <h3>材料平台</h3>
        <ul>
          <li><a href={sitePath("/learn/gaas-850-nm-and-vcsel/")}>GaAs and VCSEL</a></li>
          <li><a href={sitePath("/learn/inp-1310-1550-nm-and-high-speed-communication/")}>InP communication platform</a></li>
          <li><a href={sitePath("/learn/why-no-single-material-wins-everything/")}>Why no single material wins everything</a></li>
        </ul>
      </div>

      <div>
        <h3>原料与晶圆</h3>
        <ul>
          <li><a href={sitePath("/learn/in-p-ga-as-si-ge-and-linbo3/")}>In, P, Ga, As, Si, Ge, and LiNbO3</a></li>
          <li><a href={sitePath("/learn/raw-material-ingot-wafer-substrate-and-epi-ready-wafer/")}>Raw material to epi-ready wafer</a></li>
          <li><a href={sitePath("/learn/high-purity-raw-materials/")}>High-purity raw materials</a></li>
          <li><a href={sitePath("/learn/polycrystal-synthesis/")}>Polycrystal synthesis</a></li>
          <li><a href={sitePath("/learn/single-crystal-growth/")}>Single-crystal growth</a></li>
          <li><a href={sitePath("/components/laser-source/substrate-epitaxy/")}>衬底与外延</a></li>
          <li><a href={sitePath("/learn/gaas-substrate/")}>GaAs substrate</a></li>
          <li><a href={sitePath("/learn/soi-wafer/")}>SOI wafer</a></li>
          <li><a href={sitePath("/learn/lnoi-wafer/")}>LNOI wafer</a></li>
        </ul>
      </div>

      <div>
        <h3>物理基础</h3>
        <ul>
          <li><a href={sitePath("/learn/photon-wavelength-frequency-and-energy/")}>Photon, wavelength, frequency, and energy</a></li>
          <li><a href={sitePath("/learn/refractive-index-and-total-internal-reflection/")}>Refractive index and total internal reflection</a></li>
          <li><a href={sitePath("/learn/valence-band-conduction-band-and-bandgap/")}>Valence band, conduction band, and bandgap</a></li>
          <li><a href={sitePath("/learn/direct-vs-indirect-bandgap/")}>Direct vs indirect bandgap</a></li>
          <li><a href={sitePath("/learn/pn-junction-and-carrier-injection/")}>PN junction and carrier injection</a></li>
          <li><a href={sitePath("/learn/waveguides-and-optical-modes/")}>Waveguides and optical modes</a></li>
          <li><a href={sitePath("/learn/interference-resonance-and-loss/")}>Interference, resonance, and loss</a></li>
        </ul>
      </div>

      <div>
        <h3>激光器原理</h3>
        <ul>
          <li><a href={sitePath("/learn/spontaneous-vs-stimulated-emission/")}>Spontaneous vs stimulated emission</a></li>
          <li><a href={sitePath("/learn/laser-linewidth-and-mode-stability/")}>Laser linewidth and mode stability</a></li>
          <li><a href={sitePath("/learn/vertical-and-lateral-optical-confinement/")}>Vertical and lateral optical confinement</a></li>
          <li><a href={sitePath("/learn/fabry-perot-cavity/")}>Fabry-Perot cavity</a></li>
        </ul>
      </div>

      <div>
        <h3>杂项</h3>
        <ul>
          <li><a href={sitePath("/learn/model-demo/")}>3D model slot demo</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
