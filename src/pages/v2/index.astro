---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { v2Chapters } from "../../data/v2Chapters";
import { sitePath } from "../../lib/paths";

const allPages = v2Chapters.flatMap((ch) => ch.pages);
const migrateCount = allPages.filter((p) => p.status === "migrate").length;
const rewriteCount = allPages.filter((p) => p.status === "rewrite").length;
const newCount = allPages.filter((p) => p.status === "new").length;
const totalPages = allPages.length;
const totalChapters = v2Chapters.length;
---

<BaseLayout
  title="LumenFab.io — 系统化学习路径"
  description="从物理基础到行业格局的 14 章光子学学习路径。"
>
  <section class="hero-panel">
    <h1>系统化学习路径</h1>
    <p class="lede">
      从物理基础到行业格局的 14 章光子学学习路径——每个章节从明确的问题出发，覆盖理论、材料、工艺、器件、系统与产业。
    </p>
  </section>

  <section>
    <div class="chapter-grid">
      {
        v2Chapters.map((chapter) => {
          const firstPage = chapter.pages[0];
          const href = firstPage
            ? sitePath(`/v2/${chapter.slug}/${firstPage.slug}/`)
            : "#";
          return (
            <a class="chapter-card" href={href}>
              <div class="chapter-card__header">
                <span class="chapter-card__number">{chapter.id}</span>
                <span class="chapter-card__title">{chapter.title}</span>
              </div>
              <p class="chapter-card__subtitle">{chapter.shortTitle}</p>
              <p class="chapter-card__purpose">{chapter.purpose}</p>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="stats-section">
    <p class="stats-line">
      {totalChapters} 章 · {totalPages} 页
      <span class="stats-breakdown">
        · {migrateCount} 页迁移 · {rewriteCount} 页重写 · {newCount} 页新写
      </span>
    </p>
  </section>
</BaseLayout>

<style>
  .chapter-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .chapter-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .chapter-card:hover,
  .chapter-card:focus-visible {
    border-color: var(--accent);
    box-shadow: 0 10px 30px rgb(15 79 73 / 10%);
    transform: translateY(-1px);
  }

  .chapter-card:focus-visible {
    outline: 3px solid rgb(29 122 107 / 25%);
    outline-offset: 3px;
  }

  .chapter-card__header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .chapter-card__number {
    font-weight: 800;
    color: var(--accent);
    font-size: 0.92rem;
  }

  .chapter-card__title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .chapter-card__subtitle {
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .chapter-card__purpose {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .stats-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .stats-line {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .stats-breakdown {
    margin-left: 0.25rem;
  }

  @media (min-width: 720px) {
    .chapter-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
