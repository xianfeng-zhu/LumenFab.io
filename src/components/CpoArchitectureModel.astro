    gap: 4px;
    padding: 5px 10px;
    font-size: 0.72rem;
    border: 1px solid var(--sl-color-gray-3, #cbd5e1);
    border-radius: 4px;
    background: rgba(248, 250, 252, 0.9);
    color: var(--sl-color-gray-5, #475569);
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition: all 0.15s;
  }
  .cpo-model__control-btn:hover {
    border-color: var(--sl-color-accent, #0d9488);
    color: var(--sl-color-accent, #0d9488);
  }
  .cpo-model__control-btn[aria-pressed="true"] {
    background: var(--sl-color-accent, #0d9488);
    color: #fff;
    border-color: var(--sl-color-accent, #0d9488);
  }
  .cpo-model__slider {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }
  .cpo-model__slider input {
    width: 160px;
  }
  .cpo-model__slider span {
    font-size: 0.68rem;
    color: var(--sl-color-gray-4, #94a3b8);
  }
  .cpo-model__index {
    display: flex;
