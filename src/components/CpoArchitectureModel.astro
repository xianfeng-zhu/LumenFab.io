  .cpo-model__info {
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-5, #475569);
    line-height: 1.55;
  }
  .cpo-model__info strong {
    display: block;
    color: var(--sl-color-gray-6, #334155);
  }
  .cpo-model__info strong::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--part-title-color, var(--sl-color-accent, #0d9488));
    margin-right: 5px;
    vertical-align: middle;
    position: relative;
    top: -1px;
  }
  figcaption {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-4, #94a3b8);
    text-align: center;
  }
  figcaption strong {
    font-weight: 600;
    color: var(--sl-color-gray-5, #64748b);
  }
  figcaption span {
    display: block;
  }
</style>
