---
const colors = {
  pcb:     "#334155",
  bga:     "#94a3b8",
  substrate:"#475569",
  interposer:"#64748b",
  tsv:     "#fbbf24",
  asicDie: "#1e40af",
  asicPkg: "#3b82f6",
  heatsink:"#94a3b8",
  lid:     "#94a3b8",
  engine:  "#0d9488",
  eic:     "#7c3aed",
  pic:     "#0d9488",
  laser:   "#f59e0b",
  fiber:   "#ef4444",
  trace:   "#f97316",
  cage:    "#78716c",
  module:  "#d97706",
  tosa:    "#f59e0b",
  rosa:    "#0d9488",
  dsp:     "#7c3aed",
  socket:  "#78716c",
  bolt:    "#57534e",
  hybrid:  "#f59e0b",
  hbm:     "#3b82f6",
  c4bump:  "#cbd5e1",
  elsfp:   "#d97706",
};
---

<figure class="pkg-compare" aria-label="五种封装架构剖面对比示意图">
  <figcaption>
    <strong>五种封装架构对比（剖面示意图）</strong>
    <span>从左到右：前面板可插拔 → NPO → 焊接式 CPO → 插座式 CPO → 3D 堆叠光学。同等比例，统一配色。</span>
  </figcaption>
  <div class="pkg-compare__svg-wrap">
    <svg viewBox="0 0 1100 420" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="封装架构对比图">
      <defs>
        <pattern id="bga-dots" width="10" height="10" patternUnits="userSpaceOnUse"><circle cx="5" cy="5" r="2.2" fill={colors.bga}/></pattern>
        <pattern id="tsv-dash" width="12" height="12" patternUnits="userSpaceOnUse"><line x1="6" y1="0" x2="6" y2="8" stroke={colors.tsv} stroke-width="1.5" opacity="0.7"/></pattern>
        <pattern id="c4-dots" width="16" height="8" patternUnits="userSpaceOnUse"><ellipse cx="8" cy="4" rx="3" ry="2" fill={colors.c4bump}/></pattern>
        <marker id="arrow-red" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill={colors.fiber}/></marker>
        <linearGradient id="grad-lid" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={colors.heatsink}/></linearGradient>
        <linearGradient id="grad-elsfp" x1="1" y1="0" x2="0" y2="0"><stop offset="0%" stop-color={colors.elsfp} stop-opacity="0"/><stop offset="100%" stop-color={colors.elsfp}/></linearGradient>
      </defs>

      <!-- ================================================================ -->
      <!-- 1. PLUGGABLE (X: 0-190) -->
      <!-- ================================================================ -->
      <g transform="translate(0,0)">
        <text x="95" y="18" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">① 前面板可插拔</text>

        <!-- PCB -->
        <rect x="5" y="260" width="180" height="10" fill={colors.pcb} rx="1"/>
        <!-- BGA dots -->
        <rect x="30" y="248" width="60" height="12" fill="url(#bga-dots)" rx="2"/>
        <!-- ASIC package substrate -->
        <rect x="32" y="225" width="56" height="23" fill={colors.substrate} rx="3"/>
        <!-- ASIC die -->
        <rect x="38" y="205" width="44" height="20" fill={colors.asicDie} rx="2"/>
        <text x="60" y="218" text-anchor="middle" font-size="7" fill="#fff" font-weight="500">ASIC</text>
        <!-- ASIC heatsink -->
        <rect x="30" y="185" width="60" height="20" fill="url(#grad-lid)" rx="2"/>
        <text x="60" y="197" text-anchor="middle" font-size="6" fill="#475569">散热器</text>
        <!-- Airflow arrows -->
        <line x1="45" y1="175" x2="45" y2="165" stroke="#94a3b8" stroke-width="1"/><polygon points="45,163 42,167 48,167" fill="#94a3b8"/>
        <line x1="75" y1="175" x2="75" y2="165" stroke="#94a3b8" stroke-width="1"/><polygon points="75,163 72,167 78,167" fill="#94a3b8"/>

        <!-- Long traces: serpentine -->
        <path d="M88,253 L140,253 L140,243 L170,243" stroke={colors.trace} stroke-width="1.5" fill="none" stroke-dasharray="4,2"/>
        <text x="130" y="239" text-anchor="middle" font-size="6" fill={colors.trace}>~150 mm</text>

        <!-- Cage -->
        <rect x="138" y="305" width="45" height="42" fill="none" stroke={colors.cage} stroke-width="1.5" rx="2"/>
        <text x="160" y="340" text-anchor="middle" font-size="6" fill={colors.cage}>笼体</text>
        <!-- Cage heatsink -->
        <rect x="140" y="295" width="41" height="10" fill="url(#grad-lid)" rx="1"/>
        <!-- Module inside cage -->
        <rect x="141" y="307" width="39" height="28" fill={colors.module} rx="3"/>
        <text x="160" y="323" text-anchor="middle" font-size="6" fill="#fff" font-weight="500">QSFP-DD</text>
        <!-- DSP -->
        <rect x="145" y="312" width="16" height="8" fill={colors.dsp} rx="1"/>
        <text x="153" y="318" text-anchor="middle" font-size="4.5" fill="#fff">DSP</text>
        <!-- TOSA -->
        <rect x="163" y="312" width="14" height="8" fill={colors.tosa} rx="1"/>
        <text x="170" y="318" text-anchor="middle" font-size="4.5" fill="#fff">TX</text>
        <!-- Fiber from module front -->
        <line x1="180" y1="320" x2="188" y2="320" stroke={colors.fiber} stroke-width="2"/>
        <!-- Front panel line -->
        <line x1="185" y1="285" x2="185" y2="350" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"/>
        <text x="185" y="360" text-anchor="middle" font-size="6" fill="#475569">前面板</text>

        <!-- Labels -->
        <text x="60" y="380" text-anchor="middle" font-size="6" fill="#64748b">长走线损耗大</text>
      </g>

      <!-- ================================================================ -->
      <!-- 2. NPO (X: 200-410) -->
      <!-- ================================================================ -->
      <g transform="translate(210,0)">
        <text x="95" y="18" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">② NPO 近封装光学</text>

        <!-- PCB -->
        <rect x="5" y="260" width="180" height="10" fill={colors.pcb} rx="1"/>

        <!-- ASIC side -->
        <rect x="20" y="240" width="60" height="20" fill={colors.socket} rx="2"/>
        <text x="50" y="253" text-anchor="middle" font-size="5.5" fill="#fff">LGA 插座</text>
        <!-- bolts -->
        <circle cx="22" cy="242" r="3" fill={colors.bolt}/><circle cx="78" cy="242" r="3" fill={colors.bolt}/>
        <text x="22" y="236" text-anchor="middle" font-size="5" fill={colors.bolt}>螺栓</text>
        <rect x="24" y="222" width="52" height="18" fill={colors.substrate} rx="2"/>
        <rect x="30" y="206" width="40" height="16" fill={colors.asicDie} rx="2"/>
        <text x="50" y="216" text-anchor="middle" font-size="6.5" fill="#fff">ASIC</text>
        <rect x="22" y="186" width="56" height="20" fill="url(#grad-lid)" rx="2"/>

        <!-- OE module side -->
        <rect x="105" y="250" width="65" height="10" fill={colors.substrate} rx="2"/>
        <rect x="112" y="234" width="24" height="16" fill={colors.eic} rx="2"/>
        <text x="124" y="244" text-anchor="middle" font-size="5.5" fill="#fff">EIC</text>
        <rect x="138" y="234" width="24" height="16" fill={colors.pic} rx="2"/>
        <text x="150" y="244" text-anchor="middle" font-size="5.5" fill="#fff">PIC</text>
        <rect x="105" y="210" width="65" height="10" fill="url(#grad-lid)" rx="1"/>
        <!-- Fiber from OE -->
        <line x1="162" y1="242" x2="190" y2="242" stroke={colors.fiber} stroke-width="1.5"/>

        <!-- Short trace -->
        <path d="M80,252 L100,252" stroke={colors.trace} stroke-width="1.2" stroke-dasharray="3,2"/>
        <text x="90" y="248" text-anchor="middle" font-size="5" fill={colors.trace}>~50mm</text>

        <!-- ELSFP at front panel -->
        <rect x="155" y="295" width="28" height="20" fill={colors.elsfp} rx="3"/>
        <text x="169" y="307" text-anchor="middle" font-size="5.5" fill="#fff">ELSFP</text>
        <line x1="183" y1="305" x2="185" y2="305" stroke={colors.fiber} stroke-width="2"/>
        <line x1="185" y1="285" x2="185" y2="350" stroke="#475569" stroke-width="1" stroke-dasharray="3,3"/>
        <!-- Fiber route from ELSFP to OE -->
        <path d="M169,295 L169,280 L140,280 L140,242" stroke={colors.fiber} stroke-width="1" fill="none" stroke-dasharray="3,2"/>

        <text x="100" y="380" text-anchor="middle" font-size="6" fill="#64748b">ASIC 独立封装 + 板上引擎</text>
      </g>

      <!-- ================================================================ -->
      <!-- 3. SOLDERED CPO (X: 420-630) -->
      <!-- ================================================================ -->
      <g transform="translate(430,0)">
        <text x="95" y="18" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">③ 焊接式 CPO</text>

        <!-- PCB -->
        <rect x="5" y="265" width="180" height="10" fill={colors.pcb} rx="1"/>
        <!-- BGA -->
        <rect x="15" y="250" width="160" height="15" fill="url(#bga-dots)"/>
        <!-- Package substrate shared -->
        <rect x="18" y="215" width="154" height="35" fill={colors.substrate} rx="4"/>
        <text x="95" y="237" text-anchor="middle" font-size="7" fill="#cbd5e1">共享封装基板</text>

        <!-- ASIC die center -->
        <rect x="65" y="195" width="60" height="20" fill={colors.asicDie} rx="2"/>
        <text x="95" y="208" text-anchor="middle" font-size="7" fill="#fff" font-weight="500">ASIC</text>
        <!-- Engines flanking ASIC -->
        <rect x="22" y="200" width="30" height="15" fill={colors.engine} rx="2"/>
        <text x="37" y="210" text-anchor="middle" font-size="5" fill="#fff">OE</text>
        <rect x="138" y="200" width="30" height="15" fill={colors.engine} rx="2"/>
        <text x="153" y="210" text-anchor="middle" font-size="5" fill="#fff">OE</text>
        <!-- Fiber from engines -->
        <line x1="22" y1="207" x2="5" y2="207" stroke={colors.fiber} stroke-width="1.5"/>
        <line x1="168" y1="207" x2="185" y2="207" stroke={colors.fiber} stroke-width="1.5"/>

        <!-- TIM + Lid -->
        <rect x="70" y="178" width="50" height="4" fill={colors.trace} opacity="0.5"/>
        <rect x="15" y="160" width="160" height="18" fill="url(#grad-lid)" rx="2"/>
        <text x="95" y="172" text-anchor="middle" font-size="6.5" fill="#475569">散热盖 + 翅片</text>

        <!-- ELSFP hint -->
        <rect x="70" y="305" width="50" height="16" fill={colors.elsfp} rx="3"/>
        <text x="95" y="315" text-anchor="middle" font-size="5.5" fill="#fff">ELSFP 供光</text>
        <line x1="70" y1="313" x2="37" y2="240" stroke={colors.fiber} stroke-width="0.8" stroke-dasharray="2,3"/>
        <line x1="120" y1="313" x2="153" y2="240" stroke={colors.fiber} stroke-width="0.8" stroke-dasharray="2,3"/>

        <text x="95" y="380" text-anchor="middle" font-size="6" fill="#64748b">引擎焊死，不可返修</text>
      </g>

      <!-- ================================================================ -->
      <!-- 4. SOCKETED CPO (X: 640-850) -->
      <!-- ================================================================ -->
      <g transform="translate(650,0)">
        <text x="95" y="18" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">④ 插座式 CPO</text>

        <!-- PCB -->
        <rect x="5" y="265" width="180" height="10" fill={colors.pcb} rx="1"/>
        <!-- BGA -->
        <rect x="15" y="250" width="160" height="15" fill="url(#bga-dots)"/>
        <!-- Substrate -->
        <rect x="18" y="215" width="154" height="35" fill={colors.substrate} rx="4"/>

        <!-- ASIC -->
        <rect x="65" y="195" width="60" height="20" fill={colors.asicDie} rx="2"/>
        <text x="95" y="208" text-anchor="middle" font-size="7" fill="#fff">ASIC</text>

        <!-- Socketed engines -->
        <rect x="20" y="218" width="34" height="8" fill={colors.socket} rx="1"/>
        <text x="37" y="224" text-anchor="middle" font-size="4.5" fill="#fff">LGA插座</text>
        <rect x="22" y="198" width="30" height="20" fill={colors.engine} rx="2"/>
        <text x="37" y="210" text-anchor="middle" font-size="5" fill="#fff">OE</text>
        <!-- bolts -->
        <circle cx="22" cy="200" r="2.5" fill={colors.bolt}/><circle cx="50" cy="200" r="2.5" fill={colors.bolt}/>
        <text x="22" y="194" text-anchor="middle" font-size="4.5" fill={colors.bolt}>螺栓</text>

        <rect x="136" y="218" width="34" height="8" fill={colors.socket} rx="1"/>
        <rect x="138" y="198" width="30" height="20" fill={colors.engine} rx="2"/>
        <text x="153" y="210" text-anchor="middle" font-size="5" fill="#fff">OE</text>
        <circle cx="138" cy="200" r="2.5" fill={colors.bolt}/><circle cx="166" cy="200" r="2.5" fill={colors.bolt}/>
        <!-- Fiber -->
        <line x1="22" y1="207" x2="5" y2="207" stroke={colors.fiber} stroke-width="1.5"/>
        <line x1="168" y1="207" x2="185" y2="207" stroke={colors.fiber} stroke-width="1.5"/>

        <!-- Lid -->
        <rect x="15" y="160" width="160" height="18" fill="url(#grad-lid)" rx="2"/>
        <text x="95" y="172" text-anchor="middle" font-size="6.5" fill="#475569">散热盖</text>

        <text x="95" y="380" text-anchor="middle" font-size="6" fill="#64748b">引擎可拆卸返修</text>
      </g>

      <!-- ================================================================ -->
      <!-- 5. 3D STACKED (X: 860-1080) -->
      <!-- ================================================================ -->
      <g transform="translate(870,0)">
        <text x="95" y="18" text-anchor="middle" font-size="10" font-weight="600" fill="#475569">⑤ 3D 堆叠 (COUPE)</text>

        <!-- PCB -->
        <rect x="5" y="275" width="180" height="10" fill={colors.pcb} rx="1"/>
        <!-- BGA -->
        <rect x="15" y="260" width="160" height="15" fill="url(#bga-dots)"/>
        <!-- Organic substrate -->
        <rect x="20" y="248" width="150" height="12" fill={colors.substrate} rx="2"/>
        <!-- C4 bumps -->
        <rect x="25" y="238" width="140" height="10" fill="url(#c4-dots)"/>
        <text x="95" y="245" text-anchor="middle" font-size="5" fill="#64748b">C4 bump</text>
        <!-- CoWoS Interposer -->
        <rect x="22" y="210" width="146" height="28" fill={colors.interposer} rx="3"/>
        <!-- TSV -->
        <rect x="30" y="214" width="130" height="20" fill="url(#tsv-dash)"/>
        <text x="95" y="228" text-anchor="middle" font-size="5.5" fill="#cbd5e1">CoWoS 硅中介层 (TSV)</text>

        <!-- ASIC on interposer -->
        <rect x="30" y="190" width="50" height="20" fill={colors.asicDie} rx="2"/>
        <text x="55" y="202" text-anchor="middle" font-size="5.5" fill="#fff">ASIC</text>
        <!-- HBM stack -->
        <rect x="110" y="180" width="30" height="30" fill={colors.hbm} rx="2"/>
        <text x="125" y="197" text-anchor="middle" font-size="4.5" fill="#fff">HBM</text>

        <!-- COUPE engine: PIC at bottom, EIC on top -->
        <rect x="140" y="190" width="35" height="20" fill="url(#c4-dots)" rx="1"/>
        <rect x="142" y="178" width="31" height="12" fill={colors.pic} rx="2"/>
        <text x="157" y="185" text-anchor="middle" font-size="5" fill="#fff">PIC</text>
        <!-- Hybrid bond -->
        <rect x="144" y="174" width="27" height="4" fill={colors.hybrid} rx="0.5"/>
        <text x="157" y="172" text-anchor="middle" font-size="4" fill={colors.hybrid}>SoIC 混合键合</text>
        <!-- EIC -->
        <rect x="143" y="160" width="29" height="14" fill={colors.eic} rx="2"/>
        <text x="157" y="170" text-anchor="middle" font-size="5.5" fill="#fff">EIC</text>
        <!-- Micro-lens + FAU top -->
        <ellipse cx="157" cy="156" rx="8" ry="3" fill={colors.fiber} opacity="0.6"/>
        <text x="157" y="150" text-anchor="middle" font-size="4.5" fill={colors.fiber}>VBC 垂直耦合 ↑</text>

        <!-- Fiber out -->
        <line x1="157" y1="156" x2="185" y2="156" stroke={colors.fiber} stroke-width="1.5"/>

        <!-- ELSFP -->
        <rect x="70" y="330" width="50" height="16" fill={colors.elsfp} rx="3"/>
        <text x="95" y="340" text-anchor="middle" font-size="5.5" fill="#fff">ELSFP 供光</text>
        <path d="M95,330 L95,310 L157,310 L157,290" stroke={colors.fiber} stroke-width="0.8" fill="none" stroke-dasharray="2,3"/>

        <text x="95" y="380" text-anchor="middle" font-size="6" fill="#64748b">EIC 叠在 PIC 上方，混合键合</text>
      </g>

      <!-- ================================================================ -->
      <!-- Legend row -->
      <!-- ================================================================ -->
      <g transform="translate(0, 395)">
        <rect x="10" y="0" width="8" height="8" fill={colors.asicDie} rx="1"/><text x="22" y="7" font-size="6" fill="#64748b">ASIC</text>
        <rect x="58" y="0" width="8" height="8" fill={colors.engine} rx="1"/><text x="70" y="7" font-size="6" fill="#64748b">光引擎</text>
        <rect x="110" y="0" width="8" height="8" fill={colors.substrate} rx="1"/><text x="122" y="7" font-size="6" fill="#64748b">基板</text>
        <rect x="155" y="0" width="8" height="8" fill={colors.interposer} rx="1"/><text x="167" y="7" font-size="6" fill="#64748b">硅中介层</text>
        <rect x="218" y="0" width="8" height="8" fill={colors.fiber} rx="1"/><text x="230" y="7" font-size="6" fill="#64748b">光纤</text>
        <rect x="265" y="0" width="8" height="8" fill={colors.trace} rx="1"/><text x="277" y="7" font-size="6" fill="#64748b">电走线</text>
        <rect x="315" y="0" width="8" height="8" fill={colors.socket} rx="1"/><text x="327" y="7" font-size="6" fill="#64748b">LGA 插座</text>
        <rect x="375" y="0" width="8" height="8" fill={colors.bolt} rx="1"/><text x="387" y="7" font-size="6" fill="#64748b">螺栓</text>
        <rect x="420" y="0" width="8" height="8" fill={colors.hybrid} rx="1"/><text x="432" y="7" font-size="6" fill="#64748b">混合键合</text>
        <rect x="480" y="0" width="8" height="8" fill={colors.elsfp} rx="1"/><text x="492" y="7" font-size="6" fill="#64748b">ELSFP</text>
        <rect x="540" y="0" width="8" height="8" fill={colors.tsv} rx="1"/><text x="552" y="7" font-size="6" fill="#64748b">TSV</text>
        <rect x="590" y="0" width="8" height="8" fill={colors.pcb} rx="1"/><text x="602" y="7" font-size="6" fill="#64748b">PCB</text>
      </g>
    </svg>
  </div>
</figure>

<style>
  .pkg-compare {
    margin: 2rem 0;
  }
  .pkg-compare__svg-wrap {
    background: var(--sl-color-gray-1, #f8fafc);
    border: 1px solid var(--sl-color-gray-3, #cbd5e1);
    border-radius: 8px;
    overflow-x: auto;
    padding: 8px;
  }
  .pkg-compare__svg-wrap svg {
    display: block;
    width: 100%;
    min-width: 800px;
    height: auto;
  }
  figcaption {
    margin-bottom: 0.5rem;
    font-size: 0.82rem;
    color: var(--sl-color-gray-5, #64748b);
    text-align: center;
  }
  figcaption strong {
    display: block;
    font-weight: 600;
    color: var(--sl-color-gray-6, #334155);
  }
  figcaption span {
    display: block;
    font-size: 0.72rem;
    color: var(--sl-color-gray-4, #94a3b8);
  }
</style>
