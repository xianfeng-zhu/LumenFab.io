---
const colors = {
  pcb:     "#334155", bga:     "#94a3b8", substrate:"#475569",
  interposer:"#64748b", tsv:     "#fbbf24", asicDie: "#1e40af",
  heatsink:"#94a3b8", engine:  "#0d9488", eic:     "#7c3aed",
  pic:     "#0d9488", laser:   "#f59e0b", fiber:   "#ef4444",
  trace:   "#f97316", cage:    "#78716c", module:  "#d97706",
  tosa:    "#f59e0b", rosa:    "#0d9488", dsp:     "#7c3aed",
  socket:  "#78716c", bolt:    "#57534e", hybrid:  "#f59e0b",
  hbm:     "#3b82f6", c4bump:  "#cbd5e1", elsfp:   "#d97706",
};

const ROW_H = 170;  // height per architecture row
const SVG_W = 1000;

const archs = [
  {
    key: "pluggable", num: "①", title: "前面板可插拔",
    summary: "长走线损耗大 | 前面板密度瓶颈",
  },
  {
    key: "npo", num: "②", title: "NPO 近封装光学",
    summary: "ASIC 独立封装 | 引擎在 PCB 上 | ELSFP 外置供光",
  },
  {
    key: "soldered", num: "③", title: "焊接式 CPO",
    summary: "共享基板 | 电径最短 (<5 mm) | 引擎焊死不可返修",
  },
  {
    key: "socketed", num: "④", title: "插座式 CPO",
    summary: "共享基板 + LGA 插座 | 引擎可拆卸返修 | 螺栓保持机构",
  },
  {
    key: "stacked", num: "⑤", title: "3D 堆叠光学 (COUPE)",
    summary: "EIC 叠在 PIC 上方 | 混合键合 | CoWoS 硅中介层 + TSV",
  },
];
---

<figure class="pkg-compare" aria-label="五种封装架构剖面对比示意图">
  <figcaption>
    <strong>五种封装架构对比（剖面示意图）</strong>
    <span>从上到下：前面板可插拔 → NPO → 焊接式 CPO → 插座式 CPO → 3D 堆叠光学。同等比例，统一配色。</span>
  </figcaption>
  <div class="pkg-compare__svg-wrap">
    <svg viewBox={`0 0 ${SVG_W} ${ROW_H * 5 + 40}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-label="封装架构对比图">
      <defs>
        <pattern id="bga-dots" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1.8" fill={colors.bga}/></pattern>
        <pattern id="tsv-dash" width="14" height="10" patternUnits="userSpaceOnUse"><line x1="7" y1="0" x2="7" y2="7" stroke={colors.tsv} stroke-width="1.6" opacity="0.6"/></pattern>
        <pattern id="c4-dots" width="14" height="8" patternUnits="userSpaceOnUse"><ellipse cx="7" cy="4" rx="2.8" ry="1.8" fill={colors.c4bump}/></pattern>
        <linearGradient id="g-lid" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={colors.heatsink}/></linearGradient>
      </defs>

      <!-- ============================================================
           ROW 1: Pluggable
           ============================================================ -->
      <g transform="translate(0,0)">
        <text x="16" y="16" font-size="12" font-weight="700" fill="#334155">① 前面板可插拔</text>
        <text x="180" y="16" font-size="10" fill="#94a3b8">{archs[0].summary}</text>
        <!-- PCB -->
        <rect x="20" y="105" width="960" height="10" fill={colors.pcb} rx="1"/>
        <!-- ASIC side (left) -->
        <rect x="60" y="92" width="50" height="13" fill="url(#bga-dots)"/>
        <rect x="64" y="70" width="42" height="22" fill={colors.substrate} rx="3"/>
        <rect x="70" y="52" width="30" height="18" fill={colors.asicDie} rx="2"/>
        <text x="85" y="64" text-anchor="middle" font-size="8" fill="#fff" font-weight="600">ASIC</text>
        <rect x="58" y="30" width="54" height="22" fill="url(#g-lid)" rx="2"/>
        <text x="85" y="44" text-anchor="middle" font-size="7" fill="#475569">散热器</text>
        <!-- PCB traces long -->
        <path d="M110,98 L480,98 L480,82 L700,82" stroke={colors.trace} stroke-width="1.8" fill="none" stroke-dasharray="6,3"/>
        <text x="400" y="92" text-anchor="middle" font-size="7" fill={colors.trace}>~150 mm PCB 走线</text>
        <!-- Cage + module (right), cage sits ON PCB -->
        <rect x="660" y="95" width="50" height="38" fill="none" stroke={colors.cage} stroke-width="1.8" rx="2"/>
        <rect x="664" y="98" width="42" height="28" fill={colors.module} rx="3"/>
        <text x="685" y="115" text-anchor="middle" font-size="7" fill="#fff" font-weight="600">QSFP-DD</text>
        <rect x="668" y="102" width="16" height="8" fill={colors.dsp} rx="1"/><text x="676" y="108" text-anchor="middle" font-size="5" fill="#fff">DSP</text>
        <rect x="686" y="102" width="16" height="8" fill={colors.tosa} rx="1"/><text x="694" y="108" text-anchor="middle" font-size="5" fill="#fff">TOSA</text>
        <rect x="668" y="114" width="34" height="9" fill={colors.rosa} rx="1"/><text x="685" y="121" text-anchor="middle" font-size="5" fill="#fff">ROSA</text>
        <!-- Card-edge connector -->
        <rect x="675" y="126" width="20" height="4" fill={colors.substrate} rx="0.5"/>
        <text x="685" y="134" text-anchor="middle" font-size="5" fill={colors.substrate}>卡边连接器</text>
        <!-- Cage heatsink -->
        <rect x="662" y="80" width="46" height="15" fill="url(#g-lid)" rx="1"/>
        <!-- Fiber out -->
        <line x1="706" y1="112" x2="720" y2="112" stroke={colors.fiber} stroke-width="2"/>
        <!-- Front panel -->
        <line x1="725" y1="70" x2="725" y2="110" stroke="#475569" stroke-width="1.2" stroke-dasharray="4,4"/>
        <text x="725" y="65" text-anchor="middle" font-size="7" fill="#475569">前面板</text>
      </g>

      <!-- ============================================================
           ROW 2: NPO
           ============================================================ -->
      <g transform="translate(0,170)">
        <text x="16" y="16" font-size="12" font-weight="700" fill="#334155">② NPO 近封装光学</text>
        <text x="180" y="16" font-size="10" fill="#94a3b8">{archs[1].summary}</text>
        <rect x="20" y="105" width="960" height="10" fill={colors.pcb} rx="1"/>

        <!-- ASIC with LGA socket + bolts (left-center) -->
        <rect x="60" y="84" width="70" height="21" fill={colors.socket} rx="2"/>
        <text x="95" y="98" text-anchor="middle" font-size="7" fill="#fff">LGA 插座</text>
        <circle cx="64" cy="86" r="4" fill={colors.bolt}/><circle cx="126" cy="86" r="4" fill={colors.bolt}/>
        <text x="64" y="78" text-anchor="middle" font-size="6" fill={colors.bolt}>螺栓</text>
        <text x="126" y="78" text-anchor="middle" font-size="6" fill={colors.bolt}>螺栓</text>
        <rect x="66" y="64" width="58" height="20" fill={colors.substrate} rx="2"/>
        <rect x="74" y="50" width="42" height="14" fill={colors.asicDie} rx="2"/>
        <text x="95" y="60" text-anchor="middle" font-size="8" fill="#fff" font-weight="600">ASIC</text>
        <rect x="64" y="28" width="62" height="22" fill="url(#g-lid)" rx="2"/>

        <!-- OE modules on PCB (right side) -->
        <rect x="230" y="85" width="70" height="12" fill={colors.substrate} rx="2"/>
        <rect x="238" y="70" width="26" height="15" fill={colors.eic} rx="2"/><text x="251" y="80" text-anchor="middle" font-size="6.5" fill="#fff">EIC</text>
        <rect x="266" y="70" width="26" height="15" fill={colors.pic} rx="2"/><text x="279" y="80" text-anchor="middle" font-size="6.5" fill="#fff">PIC</text>
        <rect x="230" y="46" width="70" height="10" fill="url(#g-lid)" rx="1"/>
        <!-- short trace -->
        <path d="M130,94 L225,94" stroke={colors.trace} stroke-width="1.5" stroke-dasharray="5,3"/>
        <text x="178" y="89" text-anchor="middle" font-size="7" fill={colors.trace}>~50mm 走线</text>

        <!-- 2nd OE (right side) -->
        <rect x="620" y="85" width="60" height="12" fill={colors.substrate} rx="2"/>
        <rect x="626" y="72" width="22" height="13" fill={colors.eic} rx="2"/><text x="637" y="81" text-anchor="middle" font-size="6" fill="#fff">EIC</text>
        <rect x="650" y="72" width="22" height="13" fill={colors.pic} rx="2"/><text x="661" y="81" text-anchor="middle" font-size="6" fill="#fff">PIC</text>
        <rect x="620" y="48" width="60" height="10" fill="url(#g-lid)" rx="1"/>
        <line x1="650" y1="79" x2="730" y2="79" stroke={colors.fiber} stroke-width="1.5"/>

        <!-- ELSFP at front panel -->
        <rect x="780" y="112" width="36" height="24" fill={colors.elsfp} rx="4"/>
        <text x="798" y="127" text-anchor="middle" font-size="7" fill="#fff" font-weight="600">ELSFP</text>
        <!-- Fiber route from ELSFP to both OEs -->
        <path d="M780,124 L750,124 L750,88 L305,88" stroke={colors.fiber} stroke-width="1.2" fill="none" stroke-dasharray="4,3"/>
        <path d="M780,124 L770,124 L770,56 L740,56 L740,79" stroke={colors.fiber} stroke-width="1.2" fill="none" stroke-dasharray="4,3"/>
        <!-- Front panel -->
        <line x1="820" y1="70" x2="820" y2="115" stroke="#475569" stroke-width="1.2" stroke-dasharray="4,4"/>
        <text x="820" y="65" text-anchor="middle" font-size="7" fill="#475569">前面板</text>
        <!-- fiber from ELSFP through front panel -->
        <line x1="816" y1="124" x2="822" y2="124" stroke={colors.fiber} stroke-width="2"/>
      </g>

      <!-- ============================================================
           ROW 3: Soldered CPO
           ============================================================ -->
      <g transform="translate(0,340)">
        <text x="16" y="16" font-size="12" font-weight="700" fill="#334155">③ 焊接式 CPO</text>
        <text x="180" y="16" font-size="10" fill="#94a3b8">{archs[2].summary}</text>
        <rect x="20" y="110" width="960" height="10" fill={colors.pcb} rx="1"/>
        <!-- BGA -->
        <rect x="40" y="94" width="940" height="16" fill="url(#bga-dots)"/>
        <!-- Shared substrate -->
        <rect x="45" y="58" width="930" height="36" fill={colors.substrate} rx="4"/>
        <text x="510" y="80" text-anchor="middle" font-size="10" fill="#cbd5e1" font-weight="600">共享封装基板</text>
        <!-- ASIC center -->
        <rect x="420" y="38" width="180" height="20" fill={colors.asicDie} rx="2"/>
        <text x="510" y="51" text-anchor="middle" font-size="9" fill="#fff" font-weight="700">ASIC</text>
        <!-- Engines -->
        <rect x="60" y="42" width="140" height="16" fill={colors.engine} rx="2"/>
        <text x="130" y="53" text-anchor="middle" font-size="7" fill="#fff">OE 1</text>
        <rect x="220" y="42" width="140" height="16" fill={colors.engine} rx="2"/>
        <text x="290" y="53" text-anchor="middle" font-size="7" fill="#fff">OE 2</text>
        <rect x="640" y="42" width="140" height="16" fill={colors.engine} rx="2"/>
        <text x="710" y="53" text-anchor="middle" font-size="7" fill="#fff">OE 3</text>
        <rect x="800" y="42" width="140" height="16" fill={colors.engine} rx="2"/>
        <text x="870" y="53" text-anchor="middle" font-size="7" fill="#fff">OE 4</text>
        <!-- Fiber from engines -->
        <line x1="60" y1="50" x2="20" y2="50" stroke={colors.fiber} stroke-width="1.8"/>
        <line x1="940" y1="50" x2="980" y2="50" stroke={colors.fiber} stroke-width="1.8"/>
        <!-- TIM -->
        <rect x="420" y="24" width="180" height="6" fill={colors.trace} opacity="0.5"/>
        <rect x="380" y="14" width="180" height="10" fill={colors.trace} opacity="0.4"/>
        <!-- Lid -->
        <rect x="40" y="6" width="940" height="24" fill="url(#g-lid)" rx="3"/>
        <text x="510" y="21" text-anchor="middle" font-size="9" fill="#475569" font-weight="600">散热盖 (Lid) — 覆盖 ASIC + 全部引擎</text>
      </g>

      <!-- ============================================================
           ROW 4: Socketed CPO
           ============================================================ -->
      <g transform="translate(0,510)">
        <text x="16" y="16" font-size="12" font-weight="700" fill="#334155">④ 插座式 CPO</text>
        <text x="180" y="16" font-size="10" fill="#94a3b8">{archs[3].summary}</text>
        <rect x="20" y="110" width="960" height="10" fill={colors.pcb} rx="1"/>
        <rect x="40" y="94" width="940" height="16" fill="url(#bga-dots)"/>
        <rect x="45" y="58" width="930" height="36" fill={colors.substrate} rx="4"/>
        <!-- ASIC -->
        <rect x="400" y="38" width="200" height="20" fill={colors.asicDie} rx="2"/>
        <text x="500" y="51" text-anchor="middle" font-size="9" fill="#fff" font-weight="700">ASIC (BGA 焊接)</text>
        <!-- Socketed engines -->
        <!-- Engine + LGA socket: socket 12px + engine 20px = 32px, taller than ASIC's 20px -->
        <g transform="translate(60,38)">
          <rect x="0" y="20" width="130" height="12" fill={colors.socket} rx="1"/>
          <text x="65" y="28" text-anchor="middle" font-size="6.5" fill="#fff">LGA 插座框架</text>
          <rect x="8" y="0" width="114" height="20" fill={colors.engine} rx="2"/>
          <text x="65" y="13" text-anchor="middle" font-size="7" fill="#fff">OE 1</text>
          <circle cx="4" cy="2" r="3.5" fill={colors.bolt}/><circle cx="126" cy="2" r="3.5" fill={colors.bolt}/>
          <text x="4" y="-5" text-anchor="middle" font-size="6" fill={colors.bolt}>螺栓</text>
          <text x="126" y="-5" text-anchor="middle" font-size="6" fill={colors.bolt}>螺栓</text>
        </g>
        <g transform="translate(210,38)">
          <rect x="0" y="20" width="130" height="12" fill={colors.socket} rx="1"/>
          <text x="65" y="28" text-anchor="middle" font-size="6.5" fill="#fff">LGA 插座框架</text>
          <rect x="8" y="0" width="114" height="20" fill={colors.engine} rx="2"/>
          <text x="65" y="13" text-anchor="middle" font-size="7" fill="#fff">OE 2</text>
          <circle cx="4" cy="2" r="3.5" fill={colors.bolt}/><circle cx="126" cy="2" r="3.5" fill={colors.bolt}/>
        </g>
        <g transform="translate(640,38)">
          <rect x="0" y="20" width="130" height="12" fill={colors.socket} rx="1"/>
          <text x="65" y="28" text-anchor="middle" font-size="6.5" fill="#fff">LGA 插座框架</text>
          <rect x="8" y="0" width="114" height="20" fill={colors.engine} rx="2"/>
          <text x="65" y="13" text-anchor="middle" font-size="7" fill="#fff">OE 3</text>
          <circle cx="4" cy="2" r="3.5" fill={colors.bolt}/><circle cx="126" cy="2" r="3.5" fill={colors.bolt}/>
        </g>
        <g transform="translate(790,38)">
          <rect x="0" y="20" width="130" height="12" fill={colors.socket} rx="1"/>
          <text x="65" y="28" text-anchor="middle" font-size="6.5" fill="#fff">LGA 插座框架</text>
          <rect x="8" y="0" width="114" height="20" fill={colors.engine} rx="2"/>
          <text x="65" y="13" text-anchor="middle" font-size="7" fill="#fff">OE 4</text>
          <circle cx="4" cy="2" r="3.5" fill={colors.bolt}/><circle cx="126" cy="2" r="3.5" fill={colors.bolt}/>
        </g>
        <!-- TIM -->
        <rect x="395" y="30" width="210" height="3" fill={colors.trace} opacity="0.4"/>
        <!-- Fiber -->
        <line x1="60" y1="48" x2="20" y2="48" stroke={colors.fiber} stroke-width="1.8"/>
        <line x1="920" y1="48" x2="980" y2="48" stroke={colors.fiber} stroke-width="1.8"/>
        <!-- Lid -->
        <rect x="40" y="4" width="940" height="22" fill="url(#g-lid)" rx="3"/>
        <text x="510" y="18" text-anchor="middle" font-size="8" fill="#475569">散热盖 (Lid)</text>
      </g>

      <!-- ============================================================
           ROW 5: 3D Stacked
           ============================================================ -->
      <g transform="translate(0,680)">
        <text x="16" y="16" font-size="12" font-weight="700" fill="#334155">⑤ 3D 堆叠光学 (COUPE)</text>
        <text x="180" y="16" font-size="10" fill="#94a3b8">{archs[4].summary}</text>
        <rect x="20" y="115" width="960" height="10" fill={colors.pcb} rx="1"/>
        <rect x="40" y="100" width="940" height="15" fill="url(#bga-dots)"/>
        <!-- organic substrate -->
        <rect x="50" y="86" width="920" height="14" fill={colors.substrate} rx="2"/>
        <text x="510" y="96" text-anchor="middle" font-size="7" fill="#cbd5e1">有机基板</text>
        <!-- C4 bumps -->
        <rect x="55" y="76" width="910" height="10" fill="url(#c4-dots)"/>
        <text x="510" y="83" text-anchor="middle" font-size="6.5" fill="#64748b">C4 bump → 连接中介层与有机基板</text>
        <!-- CoWoS interposer -->
        <rect x="50" y="46" width="910" height="30" fill={colors.interposer} rx="3"/>
        <rect x="60" y="50" width="890" height="22" fill="url(#tsv-dash)"/>
        <text x="510" y="65" text-anchor="middle" font-size="9" fill="#cbd5e1" font-weight="600">CoWoS 硅中介层 (带 TSV)</text>

        <!-- ASIC -->
        <rect x="80" y="28" width="100" height="18" fill={colors.asicDie} rx="2"/>
        <text x="130" y="40" text-anchor="middle" font-size="7" fill="#fff" font-weight="600">ASIC</text>
        <!-- HBM stacks -->
        <rect x="210" y="20" width="60" height="26" fill={colors.hbm} rx="2"/>
        <text x="240" y="35" text-anchor="middle" font-size="6" fill="#fff">HBM</text>
        <rect x="280" y="20" width="60" height="26" fill={colors.hbm} rx="2"/>
        <text x="310" y="35" text-anchor="middle" font-size="6" fill="#fff">HBM</text>

        <!-- COUPE engine: stacked PIC + hybrid bond + EIC -->
        <g transform="translate(650,10)">
          <rect x="0" y="36" width="15" height="12" fill="url(#c4-dots)"/>
          <rect x="2" y="24" width="65" height="12" fill={colors.pic} rx="2"/>
          <text x="34" y="32" text-anchor="middle" font-size="7" fill="#fff">PIC (~5μm)</text>
          <rect x="4" y="20" width="61" height="4" fill={colors.hybrid} rx="0.5"/>
          <text x="34" y="17" text-anchor="middle" font-size="6.5" fill={colors.hybrid} font-weight="600">SoIC 混合键合</text>
          <rect x="3" y="4" width="63" height="16" fill={colors.eic} rx="2"/>
          <text x="34" y="14" text-anchor="middle" font-size="7" fill="#fff">EIC (50μm)</text>
        </g>
        <!-- Engine 1: vertical coupling + micro-lens -->
        <text x="684" y="38" text-anchor="middle" font-size="6.5" fill={colors.fiber}>↑ VBC 耦合</text>
        <ellipse cx="684" cy="2" rx="8" ry="3" fill={colors.fiber} opacity="0.4"/>
        <path d="M684,10 L684,-2" stroke={colors.fiber} stroke-width="1.5"/>
        <line x1="684" y1="-2" x2="855" y2="-2" stroke={colors.fiber} stroke-width="1.5"/>
        <!-- Engine 2 -->
        <g transform="translate(800,10)">
          <rect x="0" y="36" width="15" height="12" fill="url(#c4-dots)"/>
          <rect x="2" y="24" width="55" height="12" fill={colors.pic} rx="2"/>
          <text x="29" y="31" text-anchor="middle" font-size="6" fill="#fff">PIC</text>
          <rect x="4" y="20" width="51" height="4" fill={colors.hybrid} rx="0.5"/>
          <rect x="3" y="4" width="53" height="16" fill={colors.eic} rx="2"/>
          <text x="29" y="14" text-anchor="middle" font-size="6.5" fill="#fff">EIC</text>
        </g>
        <text x="829" y="38" text-anchor="middle" font-size="6.5" fill={colors.fiber}>↑ VBC</text>
        <ellipse cx="829" cy="2" rx="7" ry="3" fill={colors.fiber} opacity="0.4"/>
        <path d="M829,10 L829,-2" stroke={colors.fiber} stroke-width="1.5"/>
        <!-- TIM on ASIC+engines -->
        <rect x="78" y="14" width="740" height="2" fill={colors.trace} opacity="0.3"/>
        <!-- ELSFP -->
        <rect x="400" y="127" width="40" height="20" fill={colors.elsfp} rx="4"/>
        <text x="420" y="140" text-anchor="middle" font-size="7" fill="#fff" font-weight="600">ELSFP 供光</text>
        <path d="M420,127 L420,90 L650,90 L650,54" stroke={colors.fiber} stroke-width="1" fill="none" stroke-dasharray="4,3"/>
      </g>

      <!-- Legend -->
      <g transform={`translate(0,${ROW_H*5+2})`}>
        <rect x="10" y="2" width="10" height="10" fill={colors.asicDie} rx="1"/><text x="24" y="11" font-size="8" fill="#64748b">ASIC</text>
        <rect x="70" y="2" width="10" height="10" fill={colors.engine} rx="1"/><text x="84" y="11" font-size="8" fill="#64748b">光引擎</text>
        <rect x="135" y="2" width="10" height="10" fill={colors.substrate} rx="1"/><text x="149" y="11" font-size="8" fill="#64748b">封装基板</text>
        <rect x="205" y="2" width="10" height="10" fill={colors.interposer} rx="1"/><text x="219" y="11" font-size="8" fill="#64748b">硅中介层</text>
        <rect x="280" y="2" width="10" height="10" fill={colors.fiber} rx="1"/><text x="294" y="11" font-size="8" fill="#64748b">光纤</text>
        <rect x="335" y="2" width="10" height="10" fill={colors.trace} rx="1"/><text x="349" y="11" font-size="8" fill="#64748b">电走线</text>
