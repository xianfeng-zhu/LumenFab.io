---
const c = {
  pcb: "#334155", substrate: "#475569", asicDie: "#1e40af",
  heatsink: "#94a3b8", tosa: "#f59e0b", rosa: "#0d9488", dsp: "#7c3aed",
  fiber: "#ef4444", trace: "#f97316", cage: "#78716c", module: "#d97706",
};
const summary = "ASIC 独立封装在 PCB 中央，光模块插入前面板笼体，两者间靠 100–200 mm PCB 走线连接。生态成熟，现场可更换。";
---

<figure class="pkg-diag">
  <figcaption><strong>① 前面板可插拔</strong><span>{summary}</span></figcaption>
  <div class="pkg-diag__wrap">
    <svg viewBox="0 0 960 260" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="g-plug" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#cbd5e1"/>
          <stop offset="100%" stop-color={c.heatsink}/>
        </linearGradient>
      </defs>

      <!-- 系统主板 PCB -->
      <rect x="20" y="220" width="920" height="18" fill={c.pcb} rx="2"/>
      <text x="480" y="232" text-anchor="middle" font-size="11" fill="#94a3b8">系统主板 (PCB)</text>

      <!-- ASIC 封装塔（左侧，在 PCB 上） -->
      <rect x="100" y="200" width="100" height="20" fill={c.substrate} rx="3"/>
      <text x="150" y="213" text-anchor="middle" font-size="8" fill="#cbd5e1">ASIC 封装基板</text>
      <rect x="115" y="168" width="70" height="32" fill={c.asicDie} rx="3"/>
      <text x="150" y="188" text-anchor="middle" font-size="12" fill="#fff" font-weight="600">ASIC</text>
      <rect x="105" y="125" width="90" height="43" fill="url(#g-plug)" rx="3"/>
      <text x="150" y="150" text-anchor="middle" font-size="10" fill="#475569">散热器</text>

      <!-- 电路径：~150 mm PCB 走线 -->
      <path d="M200,229 L620,229" stroke={c.trace} stroke-width="2.5" fill="none" stroke-dasharray="8,4"/>
      <text x="400" y="224" text-anchor="middle" font-size="11" fill={c.trace}>~150 mm PCB 走线</text>

      <!-- 光模块（右侧，在前面板笼体内） -->
      <rect x="700" y="175" width="70" height="50" fill="none" stroke={c.cage} stroke-width="2" rx="3"/>
      <rect x="705" y="182" width="60" height="36" fill={c.module} rx="3"/>
      <rect x="710" y="188" width="22" height="12" fill={c.tosa} rx="1"/>
      <text x="721" y="196" text-anchor="middle" font-size="6" fill="#fff">TOSA</text>
      <rect x="738" y="188" width="22" height="12" fill={c.rosa} rx="1"/>
      <text x="749" y="196" text-anchor="middle" font-size="6" fill="#fff">ROSA</text>
      <rect x="710" y="204" width="50" height="10" fill={c.dsp} rx="1"/>
      <text x="735" y="211" text-anchor="middle" font-size="6" fill="#fff">DSP</text>
      <text x="735" y="230" text-anchor="middle" font-size="10" fill="#334155" font-weight="700">QSFP-DD</text>

      <!-- 前面板 -->
      <line x1="800" y1="140" x2="800" y2="240" stroke="#475569" stroke-width="1.5" stroke-dasharray="6,4"/>
      <text x="800" y="134" text-anchor="middle" font-size="11" fill="#475569">前面板</text>
      <line x1="770" y1="200" x2="790" y2="200" stroke={c.fiber} stroke-width="2"/>

      <!-- 图例 -->
      <rect x="20" y="248" width="10" height="10" fill={c.asicDie} rx="1"/><text x="34" y="257" font-size="9" fill="#64748b">ASIC</text>
      <rect x="80" y="248" width="10" height="10" fill={c.module} rx="1"/><text x="94" y="257" font-size="9" fill="#64748b">光模块</text>
      <rect x="148" y="248" width="10" height="10" fill={c.trace} rx="1"/><text x="162" y="257" font-size="9" fill="#64748b">PCB走线</text>
      <rect x="226" y="248" width="10" height="10" fill={c.fiber} rx="1"/><text x="240" y="257" font-size="9" fill="#64748b">光纤</text>
    </svg>
  </div>
</figure>
<style>
  .pkg-diag { margin: 1.8rem 0; }
  .pkg-diag__wrap { background: var(--sl-color-gray-1,#f8fafc); border:1px solid var(--sl-color-gray-3,#cbd5e1); border-radius:8px; padding:10px 8px 6px; }
  .pkg-diag__wrap svg { display:block; width:100%; height:auto; }
  .pkg-diag figcaption { margin-bottom:.4rem; }
  .pkg-diag figcaption strong { display:block; font-size:.82rem; font-weight:600; color:var(--sl-color-gray-6,#334155); text-align:center; }
  .pkg-diag figcaption span { display:block; font-size:.7rem; color:var(--sl-color-gray-4,#94a3b8); text-align:center; }
</style>
