---
const c = {
  pcb:"#334155",bga:"#94a3b8",substrate:"#475569",asicDie:"#1e40af",
  heatsink:"#94a3b8",engine:"#0d9488",eic:"#7c3aed",pic:"#0d9488",
  fiber:"#ef4444",trace:"#f97316",cage:"#78716c",module:"#d97706",
  tosa:"#f59e0b",rosa:"#0d9488",dsp:"#7c3aed",bolt:"#57534e",
};
const summary = "ASIC 独立封装在 PCB 中央，光模块插入前面板笼体，两者间靠 100–200 mm PCB 走线连接。生态成熟，现场可更换。";
---

<figure class="pkg-diag">
  <figcaption><strong>① 前面板可插拔</strong><span>{summary}</span></figcaption>
  <div class="pkg-diag__wrap">
    <svg viewBox="0 0 960 130" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="bg-d" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1.8" fill={c.bga}/></pattern>
        <linearGradient id="g-l" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={c.heatsink}/></linearGradient>
      </defs>
      <!-- PCB -->
      <rect x="20" y="95" width="920" height="10" fill={c.pcb} rx="1"/>
      <!-- ASIC -->
      <rect x="60" y="82" width="50" height="13" fill="url(#bg-d)"/>
      <rect x="64" y="60" width="42" height="22" fill={c.substrate} rx="3"/>
      <rect x="70" y="42" width="30" height="18" fill={c.asicDie} rx="2"/>
      <text x="85" y="54" text-anchor="middle" font-size="9" fill="#fff" font-weight="600">ASIC</text>
      <rect x="58" y="20" width="54" height="22" fill="url(#g-l)" rx="2"/>
      <text x="85" y="34" text-anchor="middle" font-size="7" fill="#475569">散热器</text>
      <!-- long trace -->
      <path d="M110,88 L460,88 L460,72 L700,72" stroke={c.trace} stroke-width="2" fill="none" stroke-dasharray="6,3"/>
      <text x="400" y="82" text-anchor="middle" font-size="8" fill={c.trace}>~150 mm PCB 走线</text>
      <!-- cage + module -->
      <rect x="660" y="85" width="50" height="38" fill="none" stroke={c.cage} stroke-width="1.8" rx="2"/>
      <rect x="664" y="88" width="42" height="28" fill={c.module} rx="3"/>
      <text x="685" y="105" text-anchor="middle" font-size="7" fill="#fff" font-weight="600">QSFP-DD</text>
      <rect x="668" y="92" width="16" height="8" fill={c.dsp} rx="1"/><text x="676" y="98" text-anchor="middle" font-size="5" fill="#fff">DSP</text>
      <rect x="686" y="92" width="16" height="8" fill={c.tosa} rx="1"/><text x="694" y="98" text-anchor="middle" font-size="5" fill="#fff">TOSA</text>
      <rect x="668" y="103" width="34" height="9" fill={c.rosa} rx="1"/><text x="685" y="110" text-anchor="middle" font-size="5" fill="#fff">ROSA</text>
      <!-- card-edge connector -->
      <rect x="675" y="117" width="20" height="5" fill={c.substrate} rx="0.5"/>
      <text x="685" y="126" text-anchor="middle" font-size="6" fill={c.substrate}>卡边连接器</text>
      <!-- cage heatsink -->
      <rect x="662" y="70" width="46" height="15" fill="url(#g-l)" rx="1"/>
      <!-- fiber out -->
      <line x1="706" y1="102" x2="720" y2="102" stroke={c.fiber} stroke-width="2"/>
      <!-- front panel -->
      <line x1="725" y1="60" x2="725" y2="100" stroke="#475569" stroke-width="1.2" stroke-dasharray="4,4"/>
      <text x="725" y="55" text-anchor="middle" font-size="7" fill="#475569">前面板</text>
      <!-- legend -->
      <rect x="20" y="116" width="8" height="8" fill={c.asicDie} rx="1"/><text x="32" y="123" font-size="7" fill="#64748b">ASIC</text>
      <rect x="68" y="116" width="8" height="8" fill={c.module} rx="1"/><text x="80" y="123" font-size="7" fill="#64748b">光模块</text>
      <rect x="120" y="116" width="8" height="8" fill={c.trace} rx="1"/><text x="132" y="123" font-size="7" fill="#64748b">电走线</text>
      <rect x="170" y="116" width="8" height="8" fill={c.cage} rx="1"/><text x="182" y="123" font-size="7" fill="#64748b">笼体</text>
      <rect x="212" y="116" width="8" height="8" fill={c.fiber} rx="1"/><text x="224" y="123" font-size="7" fill="#64748b">光纤</text>
    </svg>
  </div>
</figure>

<style>
  .pkg-diag { margin: 1.8rem 0; }
  .pkg-diag__wrap { background: var(--sl-color-gray-1,#f8fafc); border:1px solid var(--sl-color-gray-3,#cbd5e1); border-radius:8px; padding:10px 8px 6px; }
  .pkg-diag__wrap svg { display:block; width:100%; height:auto; }
  .pkg-diag figcaption { margin-bottom:.4rem; }
  .pkg-diag figcaption strong { display:block; font-size:.82rem; font-weight:600; color:var(--sl-color-gray-6,#334155); text-align:center; }
  .pkg-diag figcaption span { display:block; font-size:.7rem; color:var(--sl-color-gray-4,#94a3b8); text-align:center; }
</style>
