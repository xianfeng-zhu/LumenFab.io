---
const c = {
  pcb: "#334155", bga: "#94a3b8", substrate: "#475569", asicDie: "#1e40af",
  heatsink: "#94a3b8", engine: "#0d9488", socket: "#78716c", bolt: "#57534e", fiber: "#ef4444", trace: "#f97316",
};
const summary = "ASIC 仍用 BGA 焊接，光引擎改用 LGA 插座 + 四角螺栓压紧。引擎可单独拆卸返修，但保持机构占用基板面积、增加引擎高度。";
---

<figure class="pkg-diag">
  <figcaption><strong>④ 插座式 CPO</strong><span>{summary}</span></figcaption>
  <div class="pkg-diag__wrap">
    <svg viewBox="0 0 960 260" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="bg-sock" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1.8" fill={c.bga}/></pattern>
        <linearGradient id="g-sock" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={c.heatsink}/></linearGradient>
      </defs>

      <!-- 系统主板 PCB -->
      <rect x="20" y="220" width="920" height="18" fill={c.pcb} rx="2"/>
      <text x="480" y="232" text-anchor="middle" font-size="11" fill="#94a3b8">系统主板 (PCB)</text>

      <!-- 共享封装基板 -->
      <rect x="60" y="206" width="840" height="14" fill="url(#bg-sock)"/>
      <rect x="65" y="170" width="830" height="36" fill={c.substrate} rx="3"/>
      <text x="480" y="193" text-anchor="middle" font-size="9" fill="#cbd5e1" font-weight="600">共享封装基板 — ASIC 与光引擎在同一封装内</text>

      <!-- ASIC（BGA 焊接，不可拆） -->
      <rect x="330" y="142" width="140" height="28" fill={c.asicDie} rx="2"/>
      <text x="400" y="160" text-anchor="middle" font-size="11" fill="#fff" font-weight="700">ASIC (BGA 焊接)</text>

      <!-- LGA 插座（光引擎可拆卸的关键） -->
      <rect x="520" y="172" width="130" height="16" fill={c.socket} rx="2"/>
      <text x="585" y="183" text-anchor="middle" font-size="8" fill="#fff" font-weight="600">LGA 插座</text>
      <circle cx="524" cy="168" r="3.5" fill={c.bolt}/>
      <circle cx="646" cy="168" r="3.5" fill={c.bolt}/>

      <!-- 光引擎（插在插座上，可拆卸） -->
      <rect x="528" y="142" width="114" height="28" fill={c.engine} rx="2"/>
      <text x="585" y="160" text-anchor="middle" font-size="10" fill="#fff" font-weight="600">OE 1 (可拆卸)</text>

      <!-- 电路径：在基板内部 -->
      <path d="M470,178 L520,178" stroke={c.trace} stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
      <text x="495" y="165" text-anchor="middle" font-size="9" fill={c.trace} font-weight="600">< 5 mm</text>

      <!-- 光纤出光 -->
      <line x1="650" y1="156" x2="680" y2="156" stroke={c.fiber} stroke-width="2.5"/>

      <!-- ASIC 散热盖 -->
      <rect x="65" y="112" width="420" height="30" fill="url(#g-sock)" rx="3"/>
      <text x="275" y="132" text-anchor="middle" font-size="9" fill="#475569">散热盖 (ASIC)</text>

      <!-- 光引擎独立散热器（可随引擎拆卸） -->
      <rect x="530" y="118" width="110" height="24" fill="url(#g-sock)" rx="2"/>
      <text x="585" y="134" text-anchor="middle" font-size="8" fill="#475569">OE 散热器</text>

      <!-- 图例 -->
      <rect x="20" y="248" width="10" height="10" fill={c.socket} rx="1"/><text x="34" y="257" font-size="9" fill="#64748b">LGA插座</text>
      <rect x="100" y="248" width="10" height="10" fill={c.bolt} rx="1"/><text x="114" y="257" font-size="9" fill="#64748b">保持螺栓</text>
      <rect x="188" y="248" width="10" height="10" fill={c.engine} rx="1"/><text x="202" y="257" font-size="9" fill="#64748b">光引擎</text>
    </svg>
  </div>
</figure>
<style>
  .pkg-diag { margin: 1.8rem 0; }
  .pkg-diag__wrap { background: var(--sl-color-gray-1,#f8fafc); border:1px solid var(--sl-color-gray-3,#cbd5e1); border-radius:8px; padding:10px 8px 6px; }
  .pkg-diag__wrap svg { display:block; width:100%; height:auto; }
  .pkg-diag figcaption { margin-bottom:.4rem; }
  .pkg-diag figcaption strong { display:block; font-size:.82rem; font-weight:600; color:var(--sl-color-gray-6,#334155); text-align:center; }
  .pkg-diag figcaption span { display:block; font-size:.7rem; color:var(--sl-color-gray-4,#94a3b8); text-align:center; }
</style>
