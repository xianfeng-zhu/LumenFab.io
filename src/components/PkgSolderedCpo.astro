---
const c = {
  pcb: "#334155", bga: "#94a3b8", substrate: "#475569", interposer: "#64748b",
  asicDie: "#1e40af", heatsink: "#94a3b8", engine: "#0d9488", eic: "#7c3aed", pic: "#0d9488",
  fiber: "#ef4444", trace: "#f97316",
};
const summary = "ASIC 与光引擎焊接在同一块封装基板上，电径最短（<5 mm）。引擎焊死，依赖 KGD 筛选。Broadcom TH5-Bailly 为当前大规模量产代表，8 个引擎围绕 ASIC。";
---

<figure class="pkg-diag">
  <figcaption><strong>③ 焊接式 CPO</strong><span>{summary}</span></figcaption>
  <div class="pkg-diag__wrap">
    <svg viewBox="0 0 960 260" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="bg-sol" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1.8" fill={c.bga}/></pattern>
        <linearGradient id="g-sol" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={c.heatsink}/></linearGradient>
      </defs>

      <!-- 系统主板 PCB -->
      <rect x="20" y="220" width="920" height="18" fill={c.pcb} rx="2"/>
      <text x="480" y="232" text-anchor="middle" font-size="11" fill="#94a3b8">系统主板 (PCB)</text>

      <!-- 共享封装（一个大塔） — ASIC 与光引擎在同一封装内 -->
      <rect x="60" y="206" width="840" height="14" fill="url(#bg-sol)"/>
      <rect x="65" y="170" width="830" height="36" fill={c.substrate} rx="3"/>
      <text x="480" y="193" text-anchor="middle" font-size="9" fill="#cbd5e1" font-weight="600">有机封装基板 — ASIC 与光引擎共享</text>
      <rect x="70" y="150" width="820" height="20" fill={c.interposer} rx="2"/>
      <text x="480" y="163" text-anchor="middle" font-size="8" fill="#cbd5e1">硅中介层 (2.5D)</text>

      <!-- ASIC die（在共享基板上） -->
      <rect x="330" y="120" width="140" height="30" fill={c.asicDie} rx="2"/>
      <text x="400" y="139" text-anchor="middle" font-size="11" fill="#fff" font-weight="700">ASIC</text>

      <!-- 光引擎 die（也在共享基板上） -->
      <rect x="520" y="122" width="100" height="28" fill={c.engine} rx="2"/>
      <text x="570" y="140" text-anchor="middle" font-size="10" fill="#fff" font-weight="600">光引擎</text>
      <rect x="525" y="126" width="42" height="20" fill={c.eic} rx="1"/>
      <text x="546" y="139" text-anchor="middle" font-size="6" fill="#fff">EIC</text>
      <rect x="573" y="126" width="42" height="20" fill={c.pic} rx="1"/>
      <text x="594" y="139" text-anchor="middle" font-size="6" fill="#fff">PIC</text>

      <!-- 电路径：在硅中介层内部 -->
      <path d="M470,160 L520,160" stroke={c.trace} stroke-width="1.5" fill="none" stroke-dasharray="3,2"/>
      <text x="495" y="147" text-anchor="middle" font-size="9" fill={c.trace} font-weight="600">< 5 mm</text>

      <!-- 光纤出光 -->
      <line x1="620" y1="136" x2="650" y2="136" stroke={c.fiber} stroke-width="2.5"/>
      <text x="660" y="140" font-size="9" fill={c.fiber}>光纤</text>

      <!-- 散热盖 -->
      <rect x="65" y="90" width="830" height="30" fill="url(#g-sol)" rx="3"/>
      <text x="480" y="110" text-anchor="middle" font-size="10" fill="#475569" font-weight="600">散热盖 — 覆盖 ASIC + 光引擎（实际 8 个引擎围绕 ASIC）</text>

      <!-- 图例 -->
      <rect x="20" y="248" width="10" height="10" fill={c.interposer} rx="1"/><text x="34" y="257" font-size="9" fill="#64748b">硅中介层</text>
      <rect x="108" y="248" width="10" height="10" fill={c.asicDie} rx="1"/><text x="122" y="257" font-size="9" fill="#64748b">ASIC</text>
      <rect x="176" y="248" width="10" height="10" fill={c.engine} rx="1"/><text x="190" y="257" font-size="9" fill="#64748b">光引擎</text>
      <rect x="250" y="248" width="10" height="10" fill={c.trace} rx="1"/><text x="264" y="257" font-size="9" fill="#64748b">内部走线</text>
    </svg>
  </div>
</figure>
<style>
  .pkg-diag { margin: 1.8rem 0; }
  .pkg-diag__wrap { background: var(--sl-color-gray-1,#f8fafc); border:1px solid var(--sl-color-gray-3,#cbd5e1); border-radius:8px; padding:10px 8px 6px; }
  .pkg-diag__wrap svg { display:block; width:100%; height:auto; }
  .pkg-diag figcaption { margin-bottom:.4rem; }
  .pkg-diag figcaption strong { display:block; font-size:.82rem; font-weight:600; color:var(--sl-color-gray-6,#334155); text-align:center; }
  .pkg-diag figcaption span { display:block; font-size:.7rem; color:var(--sl-color-gray-4,#94a3b8); text-align:center; }
  @media (orientation: portrait) and (max-width: 768px) {
    .pkg-diag__wrap { position:relative; padding-bottom:220%; }
    .pkg-diag__wrap svg {
      position:absolute; top:50%; left:50%;
      transform:translate(-50%,-50%) rotate(90deg);
      width:auto; height:55vw; max-width:none;
    }
  }
</style>
