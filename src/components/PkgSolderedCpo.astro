---
const c = {
  pcb:"#334155",bga:"#94a3b8",substrate:"#475569",interposer:"#64748b",
  asicDie:"#1e40af",heatsink:"#94a3b8",engine:"#0d9488",fiber:"#ef4444",trace:"#f97316",
};
const summary = "ASIC 与光引擎焊接在同一块封装基板上，电径最短（<5 mm）。引擎焊死，依赖 KGD 筛选。Broadcom TH5-Bailly 为当前大规模量产代表，8 个引擎围绕 ASIC。";
---

<figure class="pkg-diag">
  <figcaption><strong>③ 焊接式 CPO</strong><span>{summary}</span></figcaption>
  <div class="pkg-diag__wrap">
    <svg viewBox="0 0 960 135" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="bg-d3" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="4" cy="4" r="1.8" fill={c.bga}/></pattern>
        <linearGradient id="g-l3" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#cbd5e1"/><stop offset="100%" stop-color={c.heatsink}/></linearGradient>
      </defs>
      <!-- PCB -->
      <rect x="20" y="105" width="920" height="10" fill={c.pcb} rx="1"/>
      <!-- BGA -->
      <rect x="40" y="88" width="900" height="17" fill="url(#bg-d3)"/>
      <!-- Organic substrate -->
      <rect x="45" y="62" width="890" height="26" fill={c.substrate} rx="3"/>
      <text x="490" y="79" text-anchor="middle" font-size="9" fill="#cbd5e1" font-weight="600">有机封装基板</text>
      <!-- 2.5D Si interposer -->
      <rect x="50" y="44" width="880" height="18" fill={c.interposer} rx="2"/>
      <text x="490" y="56" text-anchor="middle" font-size="7" fill="#cbd5e1">硅中介层 (2.5D)</text>
      <!-- ASIC center -->
      <rect x="390" y="26" width="200" height="18" fill={c.asicDie} rx="2"/>
      <text x="490" y="38" text-anchor="middle" font-size="9" fill="#fff" font-weight="700">ASIC</text>
      <!-- 8 engines -->
      <rect x="50" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="84" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE1</text>
      <rect x="130" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="164" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE2</text>
      <rect x="210" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="244" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE3</text>
      <rect x="290" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="324" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE4</text>
      <rect x="610" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="644" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE5</text>
      <rect x="690" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="724" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE6</text>
      <rect x="770" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="804" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE7</text>
      <rect x="850" y="27" width="68" height="17" fill={c.engine} rx="1"/><text x="884" y="38" text-anchor="middle" font-size="6.5" fill="#fff">OE8</text>
      <!-- Fiber -->
      <line x1="50" y1="36" x2="20" y2="36" stroke={c.fiber} stroke-width="1.5"/>
      <line x1="918" y1="36" x2="950" y2="36" stroke={c.fiber} stroke-width="1.5"/>
      <!-- TIM -->
      <rect x="50" y="12" width="880" height="5" fill={c.trace} opacity="0.4"/>
      <!-- Lid -->
      <rect x="30" y="-2" width="900" height="22" fill="url(#g-l3)" rx="3"/>
      <text x="490" y="12" text-anchor="middle" font-size="9" fill="#475569" font-weight="600">散热盖 (Lid) — 覆盖 ASIC + 8 引擎</text>
      <!-- ELSFP external -->
      <rect x="430" y="110" width="120" height="18" fill={c.fiber} opacity="0.15" rx="3"/>
      <text x="490" y="122" text-anchor="middle" font-size="7" fill="#64748b">← ELSFP 外置供光（不在封装内）</text>
      <rect x="20" y="118" width="8" height="8" fill={c.interposer} rx="1"/><text x="32" y="125" font-size="7" fill="#64748b">硅中介层</text>
      <rect x="92" y="118" width="8" height="8" fill={c.engine} rx="1"/><text x="104" y="125" font-size="7" fill="#64748b">光引擎</text>
    </svg>
  </div>
</figure>
<style>.pkg-diag{margin:1.8rem 0}.pkg-diag__wrap{background:var(--sl-color-gray-1,#f8fafc);border:1px solid var(--sl-color-gray-3,#cbd5e1);border-radius:8px;padding:10px 8px 6px}.pkg-diag__wrap svg{display:block;width:100%;height:auto}.pkg-diag figcaption{margin-bottom:.4rem}.pkg-diag figcaption strong{display:block;font-size:.82rem;font-weight:600;color:var(--sl-color-gray-6,#334155);text-align:center}.pkg-diag figcaption span{display:block;font-size:.7rem;color:var(--sl-color-gray-4,#94a3b8);text-align:center}</style>
